line_by <- function(dat, x, y, group, x_lab = NULL, y_lab = NULL, group_lab = NULL,
title = NULL, base_size = 11, colour_family = NULL) {
x_var     <- as.character(substitute(x))
y_var     <- as.character(substitute(y))
group_var <- as.character(substitute(group))
num_groups <- length(levels(fct_drop(as.factor(dat[[group_var]]))))
colour_scale <- if (is.null(colour_family)) {
scale_colour_pal_categorical(n = num_groups)
} else {
scale_colour_pal_sequential(family = colour_family, n = num_groups)
}
dat %>%
ggplot(aes(x = !!sym(x_var), y = !!sym(y_var),
group = !!sym(group_var), colour = !!sym(group_var),
linetype = !!sym(group_var))) +
geom_line(linewidth = 0.8) +
theme_house(base_size = base_size) +
colour_scale +
labs(title = title, x = x_lab, y = y_lab, colour = group_lab, linetype = group_lab)
}
line_by(dat = survey %>% mutate(age = factor(round(Age))),
y = c(Wr.Hnd, NW.Hnd),
x = age)
line_by(dat = survey %>% mutate(age = factor(round(Age))),
y = NW.Hnd,
x = age)
line_by <- function(data, outcomes, predictor, statistics = "mean",
x_lab = NULL, y_lab = NULL, group_lab = NULL, title = NULL,
base_size = 11, colour_family = NULL) {
stopifnot(length(statistics) == 1)
dat <- calc_stats(data, outcomes = outcomes, predictors = predictor,
statistics = statistics) %>%
filter(cross_break != "Total")
num_groups <- length(unique(dat$o_lab))
colour_scale <- if (is.null(colour_family)) {
scale_colour_pal_categorical(n = num_groups)
} else {
scale_colour_pal_sequential(family = colour_family, n = num_groups)
}
chart_x_lab <- if (is.null(x_lab)) dat$p_lab1[1] else x_lab
dat %>%
ggplot(aes(x = p_cat1, y = estimate, group = o_lab, colour = o_lab, linetype = o_lab)) +
geom_line(linewidth = 0.8) +
theme_house(base_size = base_size) +
colour_scale +
labs(title = title, x = chart_x_lab, y = y_lab, colour = group_lab, linetype = group_lab)
}
line_by(survey %>% mutate(age = factor(round(Age))),
outcomes = c("Wr.Hnd", "NW.Hnd"), predictor = "age")
dat %>%
ggplot(aes(x = p_cat1, y = estimate, group = o_lab, colour = o_lab, linetype = o_lab)) +
geom_line(linewidth = 0.7) +
theme_house(base_size = base_size) +
colour_scale +
labs(title = title, x = chart_x_lab, y = y_lab, colour = group_lab, linetype = group_lab)
